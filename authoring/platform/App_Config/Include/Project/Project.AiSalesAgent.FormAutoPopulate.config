<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <events>
      <!-- Auto-populate FormName dynamically whenever any page with a Form rendering is saved in Content Editor -->
      <event name="item:saving">
        <handler type="XmCloudNextJsStarter.Events.FormNameAutoPopulateHandler, XmCloudNextJsStarter" method="OnItemSaving" />
      </event>
    </events>
  </sitecore>
</configuration>
