<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <events>
      <event name="item:saving">
        <handler
          type="XmCloudNextJsStarter.Events.FormNameAutoPopulateHandler, XmCloudNextJsStarter"
          method="OnItemSaving" />
      </event>
      <event name="item:saved">
        <handler
          type="XmCloudNextJsStarter.Events.FormNameAutoPopulateHandler, XmCloudNextJsStarter"
          method="OnItemSaved" />
      </event>
    </events>
  </sitecore>
</configuration>
