<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <events>
      <!-- Auto-populate FormName whenever any page with a Form rendering is saved in Content Editor -->
      <event name="item:saving">
        <handler type="XmCloudNextJsStarter.Events.FormNameAutoPopulateHandler, XmCloudNextJsStarter" method="OnItemSaving" />
      </event>
    </events>

    <pipelines>
      <!-- Safe append to initialize pipeline without invalid patch:after selectors -->
      <initialize>
        <processor type="XmCloudNextJsStarter.Pipelines.InitializeFormNameMigration, XmCloudNextJsStarter" />
      </initialize>
    </pipelines>
  </sitecore>
</configuration>
